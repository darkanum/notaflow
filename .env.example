# Copy to .env.local for the Stage 0 spike. Never commit the real file.
NOTAFLOW_PFX_PATH=C:/path/outside/the/repo/certificate.pfx
NOTAFLOW_PFX_PASSWORD=
NOTAFLOW_EMITTER_MUNICIPALITY=0000000
# Optional: leave empty when the municipality does not require it
NOTAFLOW_EMITTER_MUNICIPAL_REGISTRATION=
NOTAFLOW_SIMPLES_NACIONAL=1
# regApTribSN, required when NOTAFLOW_SIMPLES_NACIONAL=3 (ME/EPP)
NOTAFLOW_SIMPLES_REGIME=
NOTAFLOW_SPECIAL_REGIME=0
NOTAFLOW_DPS_SERIES=900
NOTAFLOW_CUSTOMER_NAME=
# Domestic customer: set the CNPJ. Foreign customer (export invoice): set the NIF and the address below instead.
NOTAFLOW_CUSTOMER_CNPJ=
NOTAFLOW_CUSTOMER_NIF=
NOTAFLOW_CUSTOMER_COUNTRY=
NOTAFLOW_CUSTOMER_POSTAL_CODE=
NOTAFLOW_CUSTOMER_CITY=
NOTAFLOW_CUSTOMER_REGION=
NOTAFLOW_CUSTOMER_STREET=
NOTAFLOW_CUSTOMER_NUMBER=
NOTAFLOW_CUSTOMER_DISTRICT=
# pTotTribSN, the Simples Nacional total rate for the export invoice; empty writes indTotTrib 0
NOTAFLOW_SIMPLES_TOTAL_PERCENT=
NOTAFLOW_SERVICE_NATIONAL_CODE=010101
NOTAFLOW_SERVICE_NBS=
PYTHON=python
