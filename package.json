{
  "name": "notaflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && pnpm typecheck:root",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck:root": "tsc -p tsconfig.json",
    "spike:sefin": "tsx --env-file=.env.local spikes/2026-10-sefin/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "@notaflow/provider-nacional": "workspace:*",
    "@notaflow/signer-node": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
