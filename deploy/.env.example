# /opt/notaflow/.env on the VPS, mode 600. Never commit the real file.
# IMAGE is written by the deploy workflow after each successful pull.
IMAGE=
NODE_ENV=production
APP_ORIGIN=https://notaflow.vapulab.com
# 32 random bytes in base64, generated on the VPS: openssl rand -base64 32
# Keep a copy in the password manager, never next to the backups.
NFSE_MASTER_KEY=
AUTH_MODE=access
# From the Cloudflare Access application of notaflow.vapulab.com.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
